# ==========================================
# CryptoPulse Environment Configuration Template
# Copy this file to .env and customize values
# ==========================================

# Application Settings
PROJECT_NAME="CryptoPulse"
VERSION="0.1.0"
DEBUG=false
API_V1_STR="/api/v1"

# CORS Origins (JSON list or comma-separated for frontend domain)
CORS_ORIGINS='["*"]'

# Database Configuration (Async PostgreSQL / Neon serverless)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/cryptopulse"

# Binance WebSocket Market Ingestion
# data-stream.binance.vision is Binance's official public streaming domain (works globally)
BINANCE_WS_URL="wss://data-stream.binance.vision/stream"
TRACKED_SYMBOLS='["btcusdt", "ethusdt", "solusdt"]'
ENABLE_INGESTION=true

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
