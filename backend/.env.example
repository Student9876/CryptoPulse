# ==============================================================================
# CryptoPulse Backend Environment Configuration
# ==============================================================================

# Application Metadata
PROJECT_NAME="CryptoPulse"
VERSION="0.1.0"
DEBUG=False
API_V1_STR="/api/v1"

# CORS Origins (Comma-separated list of allowed origins or '*' for all)
CORS_ORIGINS=["*"]

# Database Connection (PostgreSQL with asyncpg driver)
# For Neon.tech, append ?ssl=require if needed
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/cryptopulse"

# Market Ingestion Configuration
# Binance public multi-stream WebSocket URL
BINANCE_WS_URL="wss://stream.binance.com:9443/stream"
# Tracked trading pairs (lowercase for Binance stream path)
TRACKED_SYMBOLS=["btcusdt", "ethusdt", "solusdt"]

# Telegram Bot Credentials
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Public URL for receiving Telegram webhook updates (leave empty to use polling in local dev)
TELEGRAM_WEBHOOK_URL=""

